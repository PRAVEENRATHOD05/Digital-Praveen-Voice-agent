<?xml version="1.0" encoding="UTF-8"?>
<svg width="200" height="200" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="avatar-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6366f1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
    </linearGradient>
  </defs>
  <!-- Background circle -->
  <circle cx="100" cy="100" r="100" fill="url(#avatar-grad)" />
  
  <!-- Head -->
  <circle cx="100" cy="70" r="30" fill="white" />
  
  <!-- Eyes -->
  <circle cx="90" cy="65" r="4" fill="#333" />
  <circle cx="110" cy="65" r="4" fill="#333" />
  
  <!-- Smile -->
  <path d="M 90 75 Q 100 82 110 75" stroke="#333" stroke-width="3" fill="none" stroke-linecap="round" />
  
  <!-- Body -->
  <rect x="75" y="105" width="50" height="60" rx="10" fill="white" />
  
  <!-- Text -->
  <text x="100" y="170" font-size="16" font-weight="bold" fill="white" text-anchor="middle">Digital</text>
  <text x="100" y="190" font-size="16" font-weight="bold" fill="white" text-anchor="middle">Praveen</text>
</svg>
